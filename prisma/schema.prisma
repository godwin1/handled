generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A row per throttled attempt (e.g. "login:<ip>:<email>", "reset:<email>",
// "signup:<ip>"). No foreign keys - this is pure rate-limit bookkeeping,
// pruned by age rather than joined against.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members   User[]
  people    Person[]
  assets    Asset[]
  accounts  Account[]
  documents Document[]
  tasks     Task[]
  invites   Invite[]
  auditLogs AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Household creator starts as admin. Admins manage member admin status
  // and per-category permissions, and are the only ones who can see the
  // audit log. Always implies full view+edit on every category, regardless
  // of any MemberPermission rows.
  isAdmin Boolean @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  assignedTasks       Task[]               @relation("TaskAssignee")
  comments            Comment[]
  sessions            Session[]
  sentInvites         Invite[]
  passwordResetTokens PasswordResetToken[]
  permissions         MemberPermission[]
  auditLogs           AuditLog[]
}

// category: people | assets | accounts | documents | tasks
// level: none | view | edit
// No row for a (user, category) pair means "edit" (full access) - the
// default for every member until an admin restricts it.
model MemberPermission {
  id        String   @id @default(cuid())
  category  String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// action: created | updated | deleted | member_joined | member_admin_changed |
//         member_permission_changed | invite_created | invite_revoked
// category: people | assets | accounts | documents | tasks | household | member
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  category    String
  entityLabel String
  detail      String?
  createdAt   DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Nullable: keep the log entry if the actor's account is later removed.
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userNameAtTime String
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedBy       User   @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// relationship: self | partner | child | parent | other
model Person {
  id           String    @id @default(cuid())
  name         String
  relationship String
  dateOfBirth  DateTime?
  createdAt    DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ownedAssets Asset[]
  accounts    Account[]
  documents   Document[]
  tasks       Task[]
}

// type: home | rental | car | scooter | phone | other
model Asset {
  id      String  @id @default(cuid())
  name    String
  type    String
  details String?

  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  accounts  Account[]
  documents Document[]
  tasks     Task[]
}

// type: utility | internet | insurance | bank | school | medical | other
model Account {
  id       String  @id @default(cuid())
  name     String
  provider String?
  type     String

  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  documents Document[]
  tasks     Task[]
}

// type: bill | id | contract | warranty | receipt | medical | other
// status: PENDING_REVIEW | CONFIRMED
model Document {
  id     String @id @default(cuid())
  title  String
  type   String
  status String @default("PENDING_REVIEW")

  fileUrl  String
  mimeType String

  merchant     String?
  amount       Float?
  currency     String?
  dueDate      DateTime?
  expiryDate   DateTime?
  policyNumber String?
  notes        String?

  // Extraction's proposed follow-up task (set at upload, consumed by the
  // confirm screen's defaults) - type: pay | renew | cancel | book | submit | call | other
  suggestedTaskTitle   String?
  suggestedTaskType    String?
  suggestedTaskDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  tasks Task[]
}

// type: pay | renew | cancel | book | submit | call | other
// status: OPEN | DONE | SNOOZED
model Task {
  id     String @id @default(cuid())
  title  String
  type   String
  status String @default("OPEN")

  dueDate     DateTime
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
