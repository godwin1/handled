generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A row per throttled attempt (e.g. "login:<ip>:<email>", "reset:<email>",
// "signup:<ip>"). No foreign keys - this is pure rate-limit bookkeeping,
// pruned by age rather than joined against.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// plan: free | plus | family - the subscription tier, independent of
// legacyFree below. subscriptionStatus mirrors Stripe's subscription.status
// (active, past_due, canceled, ...) - null means no subscription has ever
// existed (plain free tier, not a lapsed paid one).
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  plan   String  @default("free")
  // Households that existed before billing launched keep full (effectively
  // Family-tier) access forever, regardless of `plan` - set once, in the
  // migration that added this column, for every household that existed at
  // that point. Never set for households created after.
  legacyFree Boolean @default(false)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  members   User[]
  people    Person[]
  assets    Asset[]
  accounts  Account[]
  documents Document[]
  tasks     Task[]
  invites   Invite[]
  auditLogs AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Household creator starts as admin. Admins manage member admin status
  // and per-category permissions, and are the only ones who can see the
  // audit log. Always implies full view+edit on every category, regardless
  // of any MemberPermission rows.
  isAdmin Boolean @default(false)

  // AES-256-GCM encrypted (key derived from AUTH_SECRET) - never stored
  // plaintext. totpEnabled only flips true after enrollment is confirmed
  // with a valid code, so a half-finished enrollment can't lock anyone out.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  assignedTasks       Task[]               @relation("TaskAssignee")
  comments            Comment[]
  sessions            Session[]
  sentInvites         Invite[]
  passwordResetTokens PasswordResetToken[]
  permissions         MemberPermission[]
  auditLogs           AuditLog[]
  backupCodes         BackupCode[]
  pendingTwoFactors   PendingTwoFactor[]
  twoFactorRecoveryTokens TwoFactorRecoveryToken[]
  documentShareLinks  DocumentShareLink[]
  pushTokens          PushToken[]
}

// platform: android | ios. A user can have several (multiple devices);
// tokens are pruned lazily when FCM reports one as no-longer-registered,
// rather than tracked for staleness proactively.
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// category: people | assets | accounts | documents | tasks
// level: none | view | edit
// No row for a (user, category) pair means "edit" (full access) - the
// default for every member until an admin restricts it.
model MemberPermission {
  id        String   @id @default(cuid())
  category  String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// action: created | updated | deleted | member_joined | member_admin_changed |
//         member_permission_changed | invite_created | invite_revoked
// category: people | assets | accounts | documents | tasks | household | member
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  category    String
  entityLabel String
  detail      String?
  createdAt   DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Nullable: keep the log entry if the actor's account is later removed.
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userNameAtTime String
}

// Self-service recovery for someone who's completed the password step (so
// a PendingTwoFactor already proves they know the password) but lost both
// their authenticator and backup codes. Separate from admin-assisted reset
// (household.ts) which covers everyone except a locked-out sole admin.
model TwoFactorRecoveryToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedBy       User   @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Captured once at creation (not updated per-request, to avoid a write on
  // every page load) - shown in the account page's session list so a user
  // can recognize/revoke a device.
  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A short-lived record bridging "password verified" and "session created"
// when 2FA is enabled - never a real session on its own. Tracked via its
// own cookie (handled_pending_2fa), separate from the real session cookie,
// and deleted once the TOTP/backup code is verified or it expires.
model PendingTwoFactor {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Single-use recovery codes issued at 2FA enrollment, hashed like
// passwords (bcrypt) since they're bearer secrets. usedAt null = still
// valid.
model BackupCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// relationship: self | partner | child | parent | other
model Person {
  id           String    @id @default(cuid())
  name         String
  relationship String
  dateOfBirth  DateTime?
  createdAt    DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ownedAssets Asset[]
  accounts    Account[]
  documents   Document[]
  tasks       Task[]
}

// type: home | rental | car | scooter | phone | other
model Asset {
  id      String  @id @default(cuid())
  name    String
  type    String
  details String?

  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  accounts  Account[]
  documents Document[]
  tasks     Task[]
}

// type: utility | internet | insurance | bank | school | medical | other
// billingCycle: weekly | monthly | yearly | one_time - only meaningful
// when amount is set; drives the recurring-spend total on /accounts.
model Account {
  id       String  @id @default(cuid())
  name     String
  provider String?
  type     String

  amount       Float?
  currency     String?
  billingCycle String?

  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  documents Document[]
  tasks     Task[]
}

// type: bill | id | contract | warranty | receipt | medical | other
// status: PENDING_REVIEW | CONFIRMED
model Document {
  id     String @id @default(cuid())
  title  String
  type   String
  status String @default("PENDING_REVIEW")

  fileUrl  String
  mimeType String

  merchant     String?
  amount       Float?
  currency     String?
  dueDate      DateTime?
  expiryDate   DateTime?
  policyNumber String?
  notes        String?

  // Extraction's proposed follow-up task (set at upload, consumed by the
  // confirm screen's defaults) - type: pay | renew | cancel | book | submit | call | other
  suggestedTaskTitle   String?
  suggestedTaskType    String?
  suggestedTaskDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  tasks      Task[]
  shareLinks DocumentShareLink[]
}

// A scoped, unauthenticated read-only link to one document - for sharing
// with someone outside the household (an accountant, a landlord) without
// inviting them in. Token is the only credential; revokedAt/expiresAt are
// checked on every access, not just at creation.
model DocumentShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
}

// type: pay | renew | cancel | book | submit | call | other
// status: OPEN | DONE | SNOOZED
// recurrence: null (one-off) | weekly | monthly | yearly. Marking a
// recurring task done spawns the next occurrence rather than editing this
// row in place, so completed history stays intact.
model Task {
  id     String @id @default(cuid())
  title  String
  type   String
  status String @default("OPEN")

  dueDate     DateTime
  completedAt DateTime?
  recurrence  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
